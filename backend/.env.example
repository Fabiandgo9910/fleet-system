# =====================================================================
#  VARIABLES DE ENTORNO DEL BACKEND  (copiar a .env y rellenar)
#  En Render se pegan en: Service > Environment
# =====================================================================

# --- Servidor ---
NODE_ENV=production
PORT=4000
# Orígenes permitidos (CORS + Socket.IO), separados por comas. SIN barra final.
ALLOWED_ORIGINS=http://localhost:3000,https://tu-app.vercel.app
RATE_LIMIT_MAX=300            # peticiones por minuto y por IP

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # SECRETA: nunca en el frontend

# --- Web Push (npm run generate-vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tuempresa.com

# --- Empresa / regionalización ---
COMPANY_NAME=Mi Empresa
DEFAULT_COUNTRY_CODE=34       # prefijo que se añade a teléfonos de 9 dígitos

# --- Reseña por WhatsApp (ver src/config/review.config.js) ---
REVIEW_ENABLED=true
REVIEW_DELAY_MINUTES=10       # minutos tras finalizar con éxito
REVIEW_URL=https://g.page/r/TU_ENLACE_DE_RESENA/review
WHATSAPP_PROVIDER=log         # log (solo consola) | cloud_api (envío real) | disabled
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=               # token permanente de Meta (cloud_api)
WHATSAPP_PHONE_NUMBER_ID=     # ID del número de WhatsApp Business (cloud_api)
WHATSAPP_TEMPLATE_NAME=solicitud_resena
WHATSAPP_TEMPLATE_LANG=es

# --- Solo para: npm run create-superadmin ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin
