# =====================================================================
#  VARIABLES DE ENTORNO DEL FRONTEND (copiar a .env.local)
#  En Vercel: Project > Settings > Environment Variables
#  Las NEXT_PUBLIC_* son visibles en el navegador: NO pongas secretos aquí.
# =====================================================================

# --- Conexión ---
NEXT_PUBLIC_API_URL=http://localhost:4000            # URL del backend (Render), sin barra final
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                       # clave "anon public"

# --- Google Maps (Maps JavaScript API + Places API (New)) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
NEXT_PUBLIC_MAPS_COUNTRY=es                          # país para sugerir direcciones (ISO-2)
NEXT_PUBLIC_MAP_DEFAULT_LAT=40.4168
NEXT_PUBLIC_MAP_DEFAULT_LNG=-3.7038

# --- Notificaciones push (clave PÚBLICA generada en el backend) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Marca del cliente (ver src/config/brand.config.js) ---
NEXT_PUBLIC_COMPANY_NAME=Mi Empresa
NEXT_PUBLIC_COMPANY_SHORT_NAME=MiEmpresa
NEXT_PUBLIC_COMPANY_DESCRIPTION=Gestión de servicios y flota
NEXT_PUBLIC_LOGO_URL=/icons/icon-192.png
NEXT_PUBLIC_PRIMARY_COLOR=#2563eb
NEXT_PUBLIC_LOCALE=es-ES
NEXT_PUBLIC_CURRENCY=EUR
